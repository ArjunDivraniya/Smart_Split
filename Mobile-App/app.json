{
  "expo": {
    "name": "Smartsplit",
    "slug": "smartsplit",
    "scheme": "smartsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/appstore.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo/playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/playstore.png",
        "backgroundColor": "#080810"
      },
      "package": "com.arjun.smartsplit",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "whatsapp"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo/playstore.png"
    },
    "extra": {
      "eas": {
        "projectId": "ffeda28a-53aa-4df8-aa11-ee95d0f75556"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
